# ---- People IQ Recruiter Agent configuration ------------------------------
# Copy to .env (or export in your shell) and fill in the values.
# NEVER commit the real .env file.

# AI layer (required for full AI screening; without it the app runs in
# deterministic fallback mode — everything still works, screening quality is basic)
ANTHROPIC_API_KEY=
PEOPLEIQ_MODEL=claude-opus-4-8

# JWT secret (optional — auto-generated & persisted on first boot if unset)
PEOPLEIQ_SECRET_KEY=

# Bootstrap admin (optional — a random password is printed to the server log if unset)
PEOPLEIQ_ADMIN_PASSWORD=
PEOPLEIQ_ADMIN_EMAIL=admin@thepeopleiq.com

# Email sending (optional — without SMTP the system runs in draft-only mode)
PEOPLEIQ_EMAIL_SENDING=false
PEOPLEIQ_SMTP_HOST=
PEOPLEIQ_SMTP_PORT=587
PEOPLEIQ_SMTP_USER=
PEOPLEIQ_SMTP_PASSWORD=
PEOPLEIQ_SMTP_FROM=talent@thepeopleiq.com
PEOPLEIQ_SMTP_FROM_NAME=People IQ Talent Team

# Governance knobs
PEOPLEIQ_RETENTION_DAYS=365
PEOPLEIQ_REVIEW_SAMPLE_RATE=0.15
PEOPLEIQ_TOKEN_MINUTES=480

# Company labels
PEOPLEIQ_COMPANY_NAME=People IQ
PEOPLEIQ_DEFAULT_CLIENT=OculusIT
